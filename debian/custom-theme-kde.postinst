#!/bin/sh
# postinst script for custom-theme.
#
# See: dh_installdeb(1).

set -e

# Summary of how this script can be called:
#        * <postinst> 'configure' <most-recently-configured-version>
#        * <old-postinst> 'abort-upgrade' <new version>
#        * <conflictor's-postinst> 'abort-remove' 'in-favour' <package>
#          <new-version>
#        * <postinst> 'abort-remove'
#        * <deconfigured's-postinst> 'abort-deconfigure' 'in-favour'
#          <failed-install-package> <version> 'removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.
bashrc(){
	file="/etc/bash.bashrc"

	if [  $(grep -o -c1 QUILT /etc/bash.bashrc) -eq 0 ];then
		echo " " >> $file
		echo "alias ls='ls --color=auto'" >> $file
		echo "alias tree='tree -aC'" >> $file
		echo "export EDITOR=vim" >> $file
        	echo "export QUILT_PATCHES=debian/patches" >> $file	
	fi
}

#apenas seta o plymouth spinner se nao for oem
plymouth(){
    file_oem=/etc/.iso.info

if [ -e $file_oem ];then
	echo "is oem"
 else
	plymouth-set-default-theme -R spinner || true
fi	

}

theme(){
	update-alternatives --install /usr/share/desktop-base/active-theme desktop-theme /usr/share/desktop-base/merini-theme 80
}


case "$1" in
    configure)
	    plymouth
	    # o tema esta  configurado no pacote desktop-base
	    #theme
	    bashrc
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
